{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourdream-webapp-staging",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "YOURDREAM_ENV": "staging",
    "YOURDREAM_DEFAULT_PROFILE": "midterm1-hanoi-01",
    "YOURDREAM_BATCH02A_PACKAGE_ID": "YD-G09-MIDTERM1-HANOI-PRACTICE-EXAM-01"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yourdream-staging-d1",
      "database_id": "4f22972a-ffe0-47d2-aeab-2304b26359d0"
    }
  ]
}
